{
  "appId": "mx.gaabomx.binnirutas",
  "appName": "Binni Rutas Oax",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "scheme": "Binni Rutas Oax",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#0f766e"
    }
  },
  "android": {
    "includePlugins": [
      "@capacitor/haptics",
      "@capacitor/local-notifications"
    ],
    "adjustMarginsForEdgeToEdge": "force",
    "backgroundColor": "#0c0703"
  }
}
